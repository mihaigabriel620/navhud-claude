<?xml version="1.0" encoding="utf-8"?>
<!--
  A button that can be "the selected one".

  android:state_selected, not state_checked: these are plain Buttons driven by
  isSelected, because a RadioGroup would put the label beside a dot and the
  whole point of these four is that they are laid out like the corners they
  name.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/amber_wash" />
            <stroke android:width="2dp" android:color="@color/amber" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke android:width="1dp" android:color="@color/line_strong" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
</selector>
