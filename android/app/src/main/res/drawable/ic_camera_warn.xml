<?xml version="1.0" encoding="utf-8"?>
<!--
  A speed camera, not a holiday snap.

  This was Material's `photo_camera` — a consumer compact with a lens ring,
  58% ink, the heaviest glyph in the app, used to mean "you are about to be
  fined". It read as "take a picture". This is what one actually looks like
  from the road: a boxy housing on a pole, angled at the carriageway, with the
  flash unit beside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/danger">

    <!-- The pole. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,13.6h2V21h-2z" />
    <!-- The base. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8.2,21h7.6v1.7H8.2z" />
    <!-- The housing, tilted down the road. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.9,5.1l10.2,-2.7 1.5,5.6 -10.2,2.7z" />
    <!-- The lens, looking at you. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15.6,7.3l3.1,-0.8 0.9,3.4 -3.1,0.8z" />
    <!-- The flash. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.8,3.1l2.6,-0.7 0.7,2.6 -2.6,0.7z" />
</vector>
