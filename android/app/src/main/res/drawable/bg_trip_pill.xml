<?xml version="1.0" encoding="utf-8"?>
<!--
  The bottom-left trip pill. Sygic's is a single very round black slab that
  holds the search button, the trip figures and the menu together, instead of
  scattering four separate chips along the bottom edge. One shape, one shadow,
  one thing to find with your eyes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F00D1017" />
    <corners android:radius="@dimen/radius_capsule" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
