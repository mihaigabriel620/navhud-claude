<?xml version="1.0" encoding="utf-8"?>
<!--
  The search end of the trip pill when there is nowhere to go yet.

  Amber and filled, because with no destination set this is the one thing the
  driver is looking for, and a grey glyph on a black slab is not a button:
  it reads as a label for the text beside it. Waze gives the whole bottom bar
  to "Où allons-nous ?" for exactly this reason.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#26FF9D00" />
    <corners android:radius="@dimen/radius_capsule" />
    <stroke android:width="1dp" android:color="#59FF9D00" />
</shape>
