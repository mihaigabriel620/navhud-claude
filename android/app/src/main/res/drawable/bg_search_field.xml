<?xml version="1.0" encoding="utf-8"?>
<!-- The rounded search pill. Fully rounded, not a rounded rectangle: at this
     height the two read completely differently. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/line" />
    <corners android:radius="@dimen/radius_capsule" />
</shape>
