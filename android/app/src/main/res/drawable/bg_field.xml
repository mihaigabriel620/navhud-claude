<?xml version="1.0" encoding="utf-8"?>
<!--
  A field looks like a field: a filled well, not a platform underline.

  The fill is the *page* colour, which is a step down from the cards these sit
  on — but only four RGB levels down, so on a card the well was invisible
  (1.06:1) and so was its hairline (1.32:1). The stroke is the strong line
  weight for that reason: it is the only thing separating the well from the
  card in the one place fields actually appear.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/amber" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line_strong" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
</selector>
