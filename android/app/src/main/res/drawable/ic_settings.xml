<?xml version="1.0" encoding="utf-8"?>
<!--
  Sliders, not the eight-tooth cog.

  The cog is the most generic glyph in Android and it was 42% ink beside
  neighbours at 24% — nearly twice the weight of everything next to it on the
  same row of tiles.

  The knobs are rings cut with evenOdd rather than a disc over a disc: a
  vector's android:tint is a SRC_IN colour filter over the finished raster, so
  it repaints every fill including one that was there to punch a hole. The
  first draft of this icon drew its holes in the page colour and the tint
  filled them straight back in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/text_primary">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3,6.3h5.2v1.8H3zM12.8,6.3H21v1.8h-8.2z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M10.5,4.3m-2.9,0a2.9,2.9 0,1 1,5.8 0a2.9,2.9 0,1 1,-5.8 0M10.5,4.3m-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3,15.9h8.2v1.8H3zM15.8,15.9H21v1.8h-5.2z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M13.5,16.8m-2.9,0a2.9,2.9 0,1 1,5.8 0a2.9,2.9 0,1 1,-5.8 0M13.5,16.8m-1.3,0a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0" />
</vector>
