<?xml version="1.0" encoding="utf-8"?>
<!-- "End route". The one destructive control in the app, so it gets the one
     saturated red surface; nothing else in the UI is filled red.

     Darker than the obvious red: white on #E0322B measures 4.09:1, under the
     floor, and this is the control you least want someone to misread. #B81A0F
     is 5.97:1 and still unmistakably the red one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/danger_fill" />
    <corners android:radius="@dimen/radius_card" />
</shape>
