<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/amber_wash" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="2dp" android:color="@color/amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
