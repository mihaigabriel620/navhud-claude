<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification mark: the same chevron as the launcher and the map marker.

  It used to be a double chevron whose ink was 12 units wide in a 24 box —
  half-width, so it rendered as a thin sliver in the status bar. A status-bar
  icon is drawn as a silhouette in whatever colour the system picks, so it has
  to read at 24dp with no colour to help it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2.8l8.4,18.4L12,17.1 3.6,21.2z" />
</vector>
