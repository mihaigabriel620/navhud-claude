{
 "version": 8,
 "name": "NavHUD E60",
 "metadata": {
  "note": "Deliberately sparse. A nav map at 55 degrees of pitch is read in half-second glances, so everything that is not road, water or a name you might need has been left out. Amber on near-black to match the E60 head-up display."
 },
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "light": {
  "anchor": "viewport",
  "color": "#ffd9a0",
  "intensity": 0.25
 },
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#07070A"
   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    "class",
    "wood",
    "grass"
   ],
   "paint": {
    "fill-color": "#0B0E0B",
    "fill-opacity": 0.8
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#0A0D0A"
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "filter": [
    "!=",
    "brunnel",
    "tunnel"
   ],
   "paint": {
    "fill-color": "#0A1218"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "minzoom": 9,
   "paint": {
    "line-color": "#0E1A22",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     9,
     0.6,
     16,
     3
    ]
   }
  },
  {
   "id": "building",
   "type": "fill-extrusion",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 14,
   "filter": [
    "all",
    [
     "!=",
     "hide_3d",
     true
    ],
    [
     "any",
     [
      "!has",
      "render_height"
     ],
     [
      ">=",
      "render_height",
      7
     ]
    ]
   ],
   "paint": {
    "fill-extrusion-color": "#111216",
    "fill-extrusion-height": [
     "get",
     "render_height"
    ],
    "fill-extrusion-base": [
     "get",
     "render_min_height"
    ],
    "fill-extrusion-opacity": 1
   }
  },
  {
   "id": "road-minor-casing",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 13,
   "filter": [
    "in",
    "class",
    "minor",
    "service"
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#101012",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
