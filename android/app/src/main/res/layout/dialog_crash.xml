<?xml version="1.0" encoding="utf-8"?>
<!--
  The crash report, as something a driver can read.

  It used to be a stock AlertDialog whose body was fourteen raw lines of Java
  stack trace, in system grey, on first launch, before the map had even drawn.
  A stack trace is the right thing to keep and the wrong thing to lead with:
  the person holding the phone wants to know whether the app is broken, and
  only then, if they are minded to help, what it said.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_section"
    android:paddingEnd="@dimen/space_section"
    android:paddingTop="@dimen/space_section"
    android:paddingBottom="@dimen/space_wide">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crash_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/crashWhen"
        style="@style/NavHUD.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_hair" />

    <TextView
        style="@style/NavHUD.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_wide"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/crash_body"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/crashToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_wide"
        android:background="?android:attr/selectableItemBackground"
        android:minHeight="@dimen/touch_min"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/space_tight"
        android:text="@string/crash_show_details"
        android:textColor="@color/amber"
        android:textSize="@dimen/text_body" />

    <ScrollView
        android:id="@+id/crashScroll"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="@dimen/space_tight"
        android:background="@drawable/bg_field"
        android:padding="@dimen/space"
        android:visibility="gone">

        <TextView
            android:id="@+id/crashTrace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_tertiary"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_caption" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_wide"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/crashCopy"
            style="@style/NavHUD.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/crash_copy" />

        <Button
            android:id="@+id/crashOk"
            style="@style/NavHUD.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_tight"
            android:text="@string/crash_dismiss" />
    </LinearLayout>
</LinearLayout>
