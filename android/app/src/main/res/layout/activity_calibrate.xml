<?xml version="1.0" encoding="utf-8"?>
<!--
  Arrow direction calibration. Two columns because this is a landscape app:
  the dial on the left, what to do about it on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="horizontal"
    android:padding="@dimen/space_wide">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <com.mihai.navhud.ui.CompassView
            android:id="@+id/compass"
            android:layout_width="240dp"
            android:layout_height="240dp" />

        <TextView
            android:id="@+id/readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/readoutSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/space_hair"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calib_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_tight"
                android:text="@string/calib_help"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/calibState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tile"
                android:layout_marginTop="@dimen/space"
                android:padding="@dimen/space"
                android:textColor="@color/amber_bright"
                android:textSize="@dimen/text_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_wide"
                android:text="@string/calib_nudge"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_tight"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/left90"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calib_l90" />

                <Button
                    android:id="@+id/left5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_tight"
                    android:layout_weight="1"
                    android:text="@string/calib_l5" />

                <Button
                    android:id="@+id/right5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_tight"
                    android:layout_weight="1"
                    android:text="@string/calib_r5" />

                <Button
                    android:id="@+id/right90"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_tight"
                    android:layout_weight="1"
                    android:text="@string/calib_r90" />
            </LinearLayout>

            <Button
                android:id="@+id/flip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_tight"
                android:text="@string/calib_flip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_wide"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/done"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:text="@string/calib_done" />

                <Button
                    android:id="@+id/reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_tight"
                    android:text="@string/calib_reset" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_wide"
                android:paddingBottom="@dimen/space_tight"
                android:text="@string/calib_note"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
