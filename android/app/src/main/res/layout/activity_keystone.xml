<?xml version="1.0" encoding="utf-8"?>
<!--
  Aiming the picture at the windscreen. Two columns, because this is a
  landscape app and because the preview and the controls have to be visible at
  the same time: you are matching the shape on the glass to the shape here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/space_page">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/NavHUD.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keystone_title" />

        <TextView
            style="@style/NavHUD.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_hair"
            android:text="@string/keystone_intro" />

        <com.mihai.navhud.ui.KeystoneView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space" />

        <TextView
            android:id="@+id/status"
            style="@style/NavHUD.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_tight"
            android:textColor="@color/amber" />

        <TextView
            android:id="@+id/detail"
            style="@style/NavHUD.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_hair" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_section"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==== which way round ==== -->
            <LinearLayout style="@style/Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/NavHUD.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keystone_mirror_heading" />

                <TextView
                    style="@style/NavHUD.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_hair"
                    android:text="@string/keystone_mirror_help" />

                <CheckBox
                    android:id="@+id/mirrorX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_tight"
                    android:text="@string/keystone_mirror_x" />

                <CheckBox
                    android:id="@+id/mirrorY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keystone_mirror_y" />
            </LinearLayout>

            <!-- ==== keystone ==== -->
            <LinearLayout style="@style/Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/NavHUD.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keystone_shape_heading" />

                <TextView
                    style="@style/NavHUD.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_hair"
                    android:text="@string/keystone_shape_help" />

                <TextView
                    style="@style/NavHUD.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space"
                    android:text="@string/keystone_vertical" />

                <TextView
                    android:id="@+id/vValue"
                    style="@style/NavHUD.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/amber" />

                <SeekBar
                    android:id="@+id/vKeystone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:contentDescription="@string/keystone_vertical" />

                <TextView
                    style="@style/NavHUD.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_tight"
                    android:text="@string/keystone_horizontal" />

                <TextView
                    android:id="@+id/hValue"
                    style="@style/NavHUD.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/amber" />

                <SeekBar
                    android:id="@+id/hKeystone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:contentDescription="@string/keystone_horizontal" />
            </LinearLayout>

            <!-- ==== per-corner ==== -->
            <LinearLayout style="@style/Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/NavHUD.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keystone_corner_heading" />

                <TextView
                    style="@style/NavHUD.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_hair"
                    android:text="@string/keystone_corner_help" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_tight"
                    android:orientation="horizontal">

                    <Button android:id="@+id/cornerTL" style="@style/NavHUD.Button.Corner"
                        android:text="@string/corner_tl" />
                    <Button android:id="@+id/cornerTR" style="@style/NavHUD.Button.Corner"
                        android:text="@string/corner_tr" />
                    <Button android:id="@+id/cornerBR" style="@style/NavHUD.Button.Corner"
                        android:text="@string/corner_br" />
                    <Button android:id="@+id/cornerBL" style="@style/NavHUD.Button.Corner"
                        android:text="@string/corner_bl" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_tight"
                    android:orientation="vertical">

                    <Button android:id="@+id/nudgeUp" style="@style/NavHUD.Button.Nudge"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/nudge_up" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/nudgeLeft" style="@style/NavHUD.Button.Nudge"
                            android:text="@string/nudge_left" />

                        <Space
                            android:layout_width="@dimen/touch_min"
                            android:layout_height="1dp" />

                        <Button android:id="@+id/nudgeRight" style="@style/NavHUD.Button.Nudge"
                            android:text="@string/nudge_right" />
                    </LinearLayout>

                    <Button android:id="@+id/nudgeDown" style="@style/NavHUD.Button.Nudge"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/nudge_down" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_wide"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/keystone_reset" />

                <Space
                    android:layout_width="@dimen/space_tight"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/save"
                    style="@style/NavHUD.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/keystone_save" />
            </LinearLayout>

            <Button
                android:id="@+id/done"
                style="@style/NavHUD.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hair"
                android:text="@string/keystone_done" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
