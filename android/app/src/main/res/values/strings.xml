    <!-- ==== keystone / screen alignment ================================== -->

    <string name="keystone_title">Screen alignment</string>
    <string name="keystone_intro">The display is showing a test grid. Match the shape below to what you see reflected in the windscreen.</string>

    <string name="keystone_mirror_heading">Which way round</string>
    <string name="keystone_mirror_help">Lying flat on the dash and read as a reflection, the picture comes out back-to-front, so the display flips it. If the corner labels on the glass read TL, TR, BR, BL the same way round as they do here, this is right.</string>
    <string name="keystone_mirror_x">Mirror left to right</string>
    <string name="keystone_mirror_y">Mirror top to bottom</string>

    <string name="keystone_shape_heading">Keystone</string>
    <string name="keystone_shape_help">A dash that is not level with the screen turns the reflection into a trapezoid. These shorten one edge to match the other. Both only ever pull inwards, so nothing can end up off the panel.</string>
    <string name="keystone_vertical">Vertical — dash tilted forwards or back</string>
    <string name="keystone_horizontal">Horizontal — screen sitting off to one side</string>

    <string name="keystone_corner_heading">Corners</string>
    <string name="keystone_corner_help">For a windscreen that is not flat. Drag a corner on the preview, or pick one and nudge it. Moving a slider above rebuilds all four.</string>

